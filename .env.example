# This portfolio currently does not require runtime secrets for the public pages.
# Add public Vite variables here if needed, and keep real values in .env.local.

VITE_PUBLIC_SITE_URL=

# Private canvas editor. Leave these empty in the repository.
# If either value is missing, /api/editor refuses draft reads and all writes.
# EDITOR_STORE=file is only for a local server directory. It is rejected when VERCEL=1.
# A durable host store is not configured yet; do not invent one in the client.

EDITOR_ACCESS_TOKEN=
EDITOR_STORE=
EDITOR_STORE_DIR=
