# This portfolio currently does not require runtime secrets for the public pages.
# Add public Vite variables here if needed, and keep real values in .env.local.

VITE_PUBLIC_SITE_URL=

# Private canvas. Leave every value empty in git.
# Preview branch cursor/private-canvas-editor-01b2 needs:
#   EDITOR_ACCESS_TOKEN
#   a private Vercel Blob connection, which supplies BLOB_READ_WRITE_TOKEN or BLOB_STORE_ID
# Do not set these on Production. Do not prefix them with VITE_.
# EDITOR_STORE=file is local only and is rejected when VERCEL=1.
# See docs/editor-storage.md.

EDITOR_ACCESS_TOKEN=
EDITOR_STORE=
EDITOR_STORE_DIR=
EDITOR_BLOB_PREFIX=
